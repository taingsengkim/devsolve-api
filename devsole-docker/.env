POSTGRES_USER=devsolve
POSTGRES_PASSWORD=qwer

# Admin User Keycloak
KEYCLOAK_ADMIN=devsolve
KEYCLOAK_ADMIN_PASSWORD=qwer


KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=443

MINIO_USER=admin
MINIO_PASSWORD=admin123

# Must match REDIS_PASSWORD in the API's .env at the repository root.
REDIS_PASSWORD=qwer

# Must match MEILISEARCH_API_KEY in the API's .env at the repository root.
# Meilisearch refuses to start with MEILI_ENV=production unless this is at
# least 16 bytes. Generate a real one for anything but a laptop:
#   openssl rand -base64 32
MEILI_MASTER_KEY=devsolve-local-master-key