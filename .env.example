# Copy to .env at the repository root and fill in real values.
# Loaded by spring.config.import in application.yaml and parsed as a
# .properties file, so no quotes around values and no "export" prefix.
#
# .env is gitignored. Never commit real credentials.

# --- Database ---------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:8989/devsolve_db
DB_USERNAME=change-me
DB_PASSWORD=change-me

# --- Keycloak ---------------------------------------------------------
JWT_ISSUER_URI=http://localhost:7878/realms/devsolve
KEYCLOAK_SERVER_URL=http://localhost:7878
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_TARGET_REALM=devsolve

# --- MinIO ------------------------------------------------------------
# URL the API uses to reach MinIO.
#   API on the host           -> http://localhost:9000
#   API inside the compose net -> http://devsolve-minio:9000
MINIO_URL=http://localhost:9000
# Base URL browsers use for public/ objects (category icons, logos).
# Only needs setting when it differs from MINIO_URL, e.g. behind a proxy.
MINIO_PUBLIC_URL=http://localhost:9000
# Must match MINIO_USER / MINIO_PASSWORD in devsole-docker/.env.
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=devsolve

# --- Web --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
