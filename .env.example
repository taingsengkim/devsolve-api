# Copy to .env at the repository root and fill in real values.
# Loaded by spring.config.import in application.yaml and parsed as a
# .properties file, so no quotes around values and no "export" prefix.
#
# .env is gitignored. Never commit real credentials.

# --- Database ---------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:8989/devsolve_db
DB_USERNAME=change-me
DB_PASSWORD=change-me

# --- Keycloak ---------------------------------------------------------
JWT_ISSUER_URI=http://localhost:7878/realms/devsolve
KEYCLOAK_SERVER_URL=http://localhost:7878
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_TARGET_REALM=devsolve

# --- MinIO ------------------------------------------------------------
# Both URLs must point at the MinIO S3 API (port 9000), never the web
# console (port 9001). The console answers every path with its own HTML, so
# a console URL yields icons that "load" but render nothing.
#
# URL the API uses to reach MinIO.
#   API on the host            -> http://localhost:9000
#   API inside the compose net -> http://devsolve-minio:9000
MINIO_URL=http://localhost:9000
# Base URL browsers use for public/ objects (category icons, logos).
# Only needs setting when it differs from MINIO_URL, e.g. behind a proxy.
MINIO_PUBLIC_URL=http://localhost:9000
# Sanity check once running — this must return S3 XML, not HTML:
#   curl -i "$MINIO_PUBLIC_URL/$MINIO_BUCKET/public/nope.png"
#   NoSuchKey  -> correct endpoint, prefix is public
#   AccessDenied -> correct endpoint, bucket policy still needed
#   HTML page  -> wrong: that is the console, not the S3 API
# Must match MINIO_USER / MINIO_PASSWORD in devsole-docker/.env.
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=devsolve

# --- Redis ------------------------------------------------------------
# Backs the shared rate-limit counters (comment bursts, view de-duplication)
# and the category cache.
#
#   API on the host            -> localhost
#   API inside the compose net -> devsolve-redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Must match REDIS_PASSWORD in devsole-docker/.env.
REDIS_PASSWORD=change-me
# Redis 6+ ACL user. Blank means the default user.
REDIS_USERNAME=
REDIS_DATABASE=0
# false runs with no Redis at all: per-instance rate limits, no caching.
REDIS_ENABLED=true
#
# Sanity check once running:
#   docker exec -it devsolve-redis redis-cli -a "$REDIS_PASSWORD" ping   -> PONG

# --- Meilisearch ------------------------------------------------------
# Backs GET /api/v1/search. Everything in the indexes is derived from
# PostgreSQL, so this is safe to turn off (the endpoint then answers 503)
# and safe to wipe (the API refills it on its own within a sync interval).
#
#   API on the host            -> http://localhost:7700
#   API inside the compose net -> http://devsolve-meilisearch:7700
MEILISEARCH_ENABLED=false
MEILISEARCH_URL=http://localhost:7700
# Must match MEILI_MASTER_KEY in devsole-docker/.env. Meilisearch refuses to
# start in production mode with a key shorter than 16 bytes. Generate one:
#   openssl rand -base64 32
MEILISEARCH_API_KEY=change-me
# Prefix for the index names, so one Meilisearch can hold more than one
# environment. Leave blank on a laptop; set e.g. staging_ on a shared server.
MEILISEARCH_INDEX_PREFIX=
# How long a newly published program takes to become findable. There is no
# write-path hook — the indexer polls updated_at — so this is the whole
# staleness budget. Lower it for a livelier index, at the cost of one more
# query per table per interval.
MEILISEARCH_SYNC_INTERVAL=30s
#
# Sanity check once running:
#   curl "$MEILISEARCH_URL/health"   -> {"status":"available"}
# Then, as an admin:
#   GET  /api/v1/admin/search           document counts per index
#   POST /api/v1/admin/search/reindex   rebuild everything from PostgreSQL

# --- Gemini (problem duplicate check) ---------------------------------
# Backs POST /api/v1/problems/duplicate-check: reads a problem draft against
# what is already published and says which existing problems would answer it.
#
# Off by default, and off is a working deployment — the endpoint falls back to
# keyword matches and reports aiReviewed=false — so leave it off until a key
# has been provisioned.
#
# This is the only endpoint in the API that spends a third-party quota per
# request. It is rate limited per account (5/min, 40/hour) and its verdicts are
# cached in Redis for an hour, keyed by the draft and the candidates it was
# judged against.
#
# Free tier, no card required. Get a key at https://aistudio.google.com ->
# "Get API key".
#
# Worth knowing before pointing real users at it: Google's FREE tier may use
# what you send to improve their products, and what this endpoint sends is
# user-written problem drafts — stack traces, error messages, sometimes code.
# The paid tier does not. Check Google's current terms rather than this comment.
GEMINI_ENABLED=false
# Server-side only: it must never reach a browser and must never be committed.
# Rotate any key that has been pasted into chat, a log, or a screenshot.
GEMINI_API_KEY=
# Set this explicitly. Google retires model names for new keys without warning
# — gemini-2.5-flash was the default here until it started answering 404 — so
# keeping it in the environment makes the next retirement a restart rather than
# a rebuild. A retired name 404s with its replacement named in the message.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.0
# Somebody is watching a spinner. Past this the check gives up and serves the
# keyword matches it already has.
GEMINI_READ_TIMEOUT=30s
#
# Sanity check once running, as any signed-in user:
#   curl -X POST "$API/api/v1/problems/duplicate-check" \
#        -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
#        -d '{"title":"OAuth callback loses the PKCE verifier"}'
#   -> {"aiReviewed":true,"suggestions":[...]}

# --- VirusTotal -------------------------------------------------------
# Scans are submitted by the backend so this key must never reach a browser
# or be committed. Rotate any key that has been pasted into chat or logs.
# The public VirusTotal API has strict quotas and usage restrictions; use a
# licensed key when this service is operated commercially.
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
# Only reached by content VirusTotal has never seen. Anything it already
# knows is answered by hash in one request with no wait, so this budget is
# set for a genuinely new file, which takes minutes there rather than
# seconds. 6 polls is roughly 95 seconds.
VIRUSTOTAL_POLL_INTERVAL=20s
VIRUSTOTAL_MAX_POLLS=6
# Let an upload through when VirusTotal returns no verdict (down, rate
# limited, or still analysing). A malicious verdict still rejects.
#
# Leave this false. With it on, the way to get any file past the guard is to
# upload something VirusTotal has never seen -- which is what novel malware
# is. Turn it on only to keep uploads working through a VirusTotal outage,
# and turn it back off afterwards.
VIRUSTOTAL_FAIL_OPEN=false

# --- Web --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL of the web app, used to build the links inside outgoing emails.
# A team invitation links to
#   $FRONTEND_BASE_URL$FRONTEND_INVITATION_PATH/<invitationToken>
# and that page signs the user in and posts the token back to
#   POST /api/v1/organizations/invitations/{token}/accept
#
# One value, not a list — unlike CORS_ALLOWED_ORIGINS, a link in an email
# can only point at one place. Production sets
# https://www.devsolve.app; localhost is the right value on a laptop.
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_INVITATION_PATH=/invitations

# --- SMTP mail --------------------------------------------------------
# DevSolve sends from devsolve.istad@gmail.com through Gmail SMTP. On a
# server that should actually deliver, set:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_USERNAME=devsolve.istad@gmail.com
#   MAIL_PASSWORD=<Google App Password for that account>
#
# The App Password is 16 characters from myaccount.google.com/apppasswords
# (2-Step Verification has to be on first). Google shows it in four groups —
# paste it here with the spaces removed, because this file is read as
# .properties and would keep them. It is not the account password, and it
# never belongs in .env.example.
#
# Left empty here on purpose: with no MAIL_HOST nothing is delivered and
# every message that would have gone out is logged instead, which is what
# you want on a laptop.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail only sends as the account that authenticated, so this has to match
# MAIL_USERNAME (or one of its verified "send mail as" aliases).
MAIL_FROM=devsolve.istad@gmail.com
MAIL_FROM_NAME=DevSolve
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
